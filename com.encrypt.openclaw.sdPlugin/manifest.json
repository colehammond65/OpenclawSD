{
	"Name": "OpenClaw",
	"Version": "0.1.0.0",
	"Author": "encrypt",
	"Actions": [
		{
			"Name": "Setup",
			"UUID": "com.encrypt.openclaw.setup",
			"Icon": "imgs/actions/setup/icon",
			"Tooltip": "Configure the connection to your OpenClaw Gateway.",
			"PropertyInspectorPath": "ui/setup.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/setup/key",
					"TitleAlignment": "middle"
				}
			]
		},
		{
			"Name": "Status",
			"UUID": "com.encrypt.openclaw.status",
			"Icon": "imgs/actions/status/icon",
			"Tooltip": "Shows OpenClaw Gateway health and active runs.",
			"Controllers": [
				"Keypad",
				"Encoder"
			],
			"States": [
				{
					"Image": "imgs/actions/status/key",
					"TitleAlignment": "middle"
				}
			]
		},
		{
			"Name": "Run Automation",
			"UUID": "com.encrypt.openclaw.run-automation",
			"Icon": "imgs/actions/run-automation/icon",
			"Tooltip": "Runs a chosen OpenClaw automation immediately.",
			"PropertyInspectorPath": "ui/run-automation.html",
			"Controllers": [
				"Keypad",
				"Encoder"
			],
			"Encoder": {
				"layout": "$B1",
				"TriggerDescription": {
					"Push": "Run now",
					"Rotate": "Choose automation"
				}
			},
			"States": [
				{
					"Image": "imgs/actions/run-automation/key",
					"TitleAlignment": "middle"
				}
			]
		},
		{
			"Name": "Usage",
			"UUID": "com.encrypt.openclaw.usage",
			"Icon": "imgs/actions/usage/icon",
			"Tooltip": "Shows provider quota and spend for your OpenClaw agents.",
			"PropertyInspectorPath": "ui/usage.html",
			"Controllers": [
				"Keypad",
				"Encoder"
			],
			"Encoder": {
				"layout": "$B1",
				"TriggerDescription": {
					"Push": "Refresh usage"
				}
			},
			"States": [
				{
					"Image": "imgs/actions/usage/key",
					"TitleAlignment": "middle"
				}
			]
		},
		{
			"Name": "Send Prompt",
			"UUID": "com.encrypt.openclaw.send-prompt",
			"Icon": "imgs/actions/send-prompt/icon",
			"Tooltip": "Sends a fixed prompt to an OpenClaw session.",
			"PropertyInspectorPath": "ui/send-prompt.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/send-prompt/key",
					"TitleAlignment": "middle"
				}
			]
		},
		{
			"Name": "Approvals",
			"UUID": "com.encrypt.openclaw.approvals",
			"Icon": "imgs/actions/approvals/icon",
			"Tooltip": "Approve or deny OpenClaw exec approvals. Press to allow once, hold to deny.",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/approvals/key",
					"TitleAlignment": "middle"
				}
			]
		}
	],
	"Category": "OpenClaw",
	"CategoryIcon": "imgs/plugin/category-icon",
	"CodePath": "bin/plugin.js",
	"Description": "Control and monitor an OpenClaw Gateway from your Stream Deck.",
	"Icon": "imgs/plugin/marketplace",
	"SDKVersion": 3,
	"Software": {
		"MinimumVersion": "7.1"
	},
	"OS": [
		{
			"Platform": "mac",
			"MinimumVersion": "10.15"
		},
		{
			"Platform": "windows",
			"MinimumVersion": "10"
		}
	],
	"Nodejs": {
		"Version": "24",
		"Debug": "enabled"
	},
	"UUID": "com.encrypt.openclaw"
}
